local flow = require("ludobits.m.flow")
local live_unbundler = require("live_unbundler.live_unbundler")

go.property("collectionproxy1", msg.url())
go.property("collectionproxy2", msg.url())
go.property("collectionproxy3", msg.url())
go.property("collectionproxy4", msg.url())
go.property("collectionproxy_music", msg.url())

local function get_modules()
	local load_table = {}
	local priority = 1
	local function add_load_item(key, files, res_mode, by_request)
		assert(
			res_mode
				and type(res_mode) == "number"
				and (
					res_mode ~= live_unbundler.RES_HIGH_ONLY
					or res_mode ~= live_unbundler.RES_LOW_ONLY
					or res_mode ~= live_unbundler.RES_BOTH
				),
			"Resolution mode is required and must be a number between "
				.. live_unbundler.RES_HIGH_ONLY
				.. " and "
				.. live_unbundler.RES_BOTH
				.. ", got "
				.. tostring(res_mode)
		)
		priority = priority + 1
		load_table[key] = {
			priority = priority,
			files = files,
			res_mode = res_mode,
			by_request = by_request,
		}
	end

	add_load_item("two_collections", {
		"collection1",
		"collection2",
	}, live_unbundler.RES_BOTH)

	add_load_item("one_collection", {
		"collection3",
	}, live_unbundler.RES_HIGH_ONLY)

	add_load_item("request_collection", {
		"collection4",
	}, live_unbundler.RES_HIGH_ONLY, true)

	-- music.collection is an excluded proxy holding three sound components
	-- (.wav / .ogg / .opus). The packer puts its .soundc + audio children into a
	-- "music_sound" archive (see is_sound_resource in liveupdate_pack.py); the
	-- base "music" archive lists it as a dependency.
	add_load_item("music", {
		"music",
	}, live_unbundler.RES_HIGH_ONLY)

	return load_table
end

local function get_save_file(filename)
	local bundle_identifier = sys.get_config_string("project.bundle_identifier")
	return sys.get_save_file(bundle_identifier, filename)
end

local function init_live_unbundler(self)
	local modules = get_modules()

	local version = sys.get_config_string("project.version")

	local server_url = "."
	local server_path = server_url == "." and "." or string.format("%s/%s", server_url, version)

	local lowres_path = string.format("%s%s", server_path, "/liveupdatelowres/")
	local hires_path = string.format("%s%s", server_path, "/liveupdatehighres/")

	-- Route module logs to the console. live_unbundler[level] maps the numeric
	-- level (DEBUG..FATAL) to its name. Set before init to capture init-time logs.
	live_unbundler.set_log_function(function(level, message)
		pprint(string.format("[live_unbundler %s] %s", live_unbundler[level], message))
	end)
	-- Must be called before init. Keep the key stable across releases so existing
	-- installs keep their saved list of downloaded archives.
	live_unbundler.set_save_cache_key(get_save_file("liveupdate_saved_files"))
	-- Optional: disable liveupdate on a platform (e.g. Android PAD) by calling
	-- live_unbundler.set_platform_supported(false) before init. Defaults to true.
	live_unbundler.set_platform_supported(true)

	local value, error_msg = flow.until_callback(function(cb)
		live_unbundler.init(
			{
				modules = modules,
				lowres_server_path = lowres_path,
				hires_server_path = hires_path, --optional
			},
			cb,
			function(module_name)
				return true
			end
		)
	end)
end

function init(self)
	pprint("main.init")
	live_unbundler.add_listener()

	flow.start(function()
		init_live_unbundler(self)
		while not live_unbundler.is_module_loaded("two_collections") do
			flow.delay(0.1)
		end
		msg.post(self.collectionproxy1, "load")
		msg.post(self.collectionproxy2, "load")

		while not live_unbundler.is_module_loaded("one_collection") do
			flow.delay(0.1)
		end
		msg.post(self.collectionproxy3, "load")
		if not live_unbundler.is_module_loaded("request_collection") then
			flow.delay(5)

			live_unbundler.request_module_load("request_collection")
			while not live_unbundler.is_module_loaded("request_collection") do
				flow.delay(0.1)
			end
		end
		msg.post(self.collectionproxy4, "load")

		while not live_unbundler.is_module_loaded("music") do
			flow.delay(0.1)
		end
		msg.post(self.collectionproxy_music, "load")
	end)
end

local function unload_proxy(self, proxy)
	msg.post(proxy, "disable")
	msg.post(proxy, "final")
	msg.post(proxy, "unload")
end

function on_message(self, message_id, message, sender)
	pprint(message_id, message, sender)
	flow.on_message(message_id, message, sender)
	if message_id == hash("proxy_loaded") then
		msg.post(sender, "init")
		msg.post(sender, "enable")
	elseif message_id == live_unbundler.MSG_ALL_LOADED then
		if self.reloaded then
			return
		end
		self.reloaded = true
		unload_proxy(self, self.collectionproxy1)
		unload_proxy(self, self.collectionproxy2)
		timer.delay(0.1, false, function()
			msg.post(self.collectionproxy1, "load")
			msg.post(self.collectionproxy2, "load")
		end)
	end
end

function final(self)
	live_unbundler.remove_listener()
end
